{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "City Location Response",
  "type": "object",
  "required": ["country", "country abbreviation", "post code", "places"],
  "properties": {
    "country": {
      "type": "string",
      "minLength": 1
    },
    "country abbreviation": {
      "type": "string",
      "minLength": 1
    },
    "post code": {
      "type": "string"
    },
    "places": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["place name", "longitude", "latitude", "state", "state abbreviation"],
        "properties": {
          "place name": {
            "type": "string",
            "minLength": 1
          },
          "longitude": {
            "type": "string"
          },
          "latitude": {
            "type": "string"
          },
          "state": {
            "type": "string"
          },
          "state abbreviation": {
            "type": "string"
          }
        }
      }
    }
  }
}